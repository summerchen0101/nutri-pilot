# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Magic Link：Supabase Dashboard → Authentication → URL Configuration
# Redirect URLs 需包含：
#   http://localhost:3000/auth/callback
#   https://<正式網域>/auth/callback
#   nutriguard://auth/callback（Capacitor App 自訂 scheme，見 docs/mobile-capacitor.md）

# USDA FoodData Central（食品搜尋第二層）
USDA_API_KEY=

# Anthropic（Next：`lib/ai/claude.ts`；Edge Function：fetch API）
ANTHROPIC_API_KEY=
# 選填，預設 claude-sonnet-4-20250514
ANTHROPIC_MODEL=

# AI 額度：token → 美金估算 → 乘以每美金額度（預設 3000）；Next 與 Edge 共用變數名
# ANTHROPIC_INPUT_USD_PER_MTOK=3
# ANTHROPIC_OUTPUT_USD_PER_MTOK=15
# AI_QUOTA_UNITS_PER_USD=3000

# Upstash QStash（菜單生成、拍照辨識 Worker Queue）
# 僅基底網址，勿含 /v2/publish（錯設會導致 QStash 400 invalid scheme）
# 須與 Upstash Console 顯示的區域一致（例：EU 用 https://qstash-eu-central-1.upstash.io，勿混用全域網址與區域 Token）
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
# 須含 https://（例：`https://<project-ref>.supabase.co/functions/v1`）；程式會自動補上 scheme
# （Supabase CLI `secrets set` 不可用 SUPABASE_ 開頭變數名，請用 EDGE_FUNCTIONS_URL）
EDGE_FUNCTIONS_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# App 根網址（綠界 callback、Edge APP_URL、Capacitor Magic Link；正式環境須 https）
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Capacitor（見 docs/mobile-capacitor.md；改後必須 npm run cap:sync + Xcode 重 Run）
CAPACITOR_DEV=1
CAPACITOR_DEV_SERVER_URL=http://127.0.0.1:3000
# 實機同 Wi‑Fi：改 192.168.x.x 並 yarn dev:mobile（next dev -H 0.0.0.0）
# 正式 WebView：NEXT_PUBLIC_APP_URL=https://your-production-domain.com，並註解 CAPACITOR_DEV
# CAPACITOR_SERVER_URL=https://your-production-domain.com
# 選填：Edge Secrets 的 APP_URL（未設時 setup 腳本 fallback NEXT_PUBLIC_APP_URL）
# APP_URL=https://your-ngrok-or-preview.example.com

# 綠界全方位金流 AIO（Edge：`ecpay-checkout`、`ecpay-return` 等）
# 測試預設 MerchantID=2000132（見 docs/third/ecpay-integration-handbook.md）
ECPAY_STAGE=true
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=ejCk326UnaZWKisg
ECPAY_HASH_IV=q9jcZX8Ib9LM8wYk

# 綠界物流 C2C（測試 MerchantID=2000933，與金流 key 分開）
ECPAY_LOGISTICS_MERCHANT_ID=2000933
ECPAY_LOGISTICS_HASH_KEY=XBERn1YOvpM9nfZc
ECPAY_LOGISTICS_HASH_IV=h1ONHk4P4yqbl5LK
ECPAY_LOGISTICS_SENDER_NAME=品牌名稱
ECPAY_LOGISTICS_SENDER_CELLPHONE=0912345678
ECPAY_LOGISTICS_SENDER_ZIP_CODE=100
ECPAY_LOGISTICS_SENDER_ADDRESS=台北市中正區範例路1號
# 宅配子類型：TCAT 或 POST
# ECPAY_HOME_LOGISTICS_SUBTYPE=TCAT
